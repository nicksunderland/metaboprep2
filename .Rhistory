stack_matrices <- function(mat_list, type) {
ref_mat <- mat_list[[1]]
for (i in 2:length(mat_list)) {
mat <- mat_list[[i]]
rownames(ref_mat) <- intersect(rownames(ref_mat), rownames(mat))
ref_mat <- ref_mat[rownames(ref_mat), , drop = FALSE]
mat <- mat[rownames(ref_mat), , drop = FALSE]
colnames(ref_mat) <- intersect(colnames(ref_mat), colnames(mat))
ref_mat <- ref_mat[, colnames(ref_mat), drop = FALSE]
mat <- mat[, colnames(ref_mat), drop = FALSE]
missing_rows_ref <- setdiff(rownames(mat), rownames(ref_mat))
missing_rows_mat <- setdiff(rownames(ref_mat), rownames(mat))
missing_cols_ref <- setdiff(colnames(mat), colnames(ref_mat))
missing_cols_mat <- setdiff(colnames(ref_mat), colnames(mat))
if(length(missing_rows_ref) > 0) {
mat[missing_rows_ref, ] <- NA
}
if(length(missing_rows_mat) > 0) {
ref_mat[missing_rows_mat, ] <- NA
}
if(length(missing_cols_ref) > 0) {
mat[, missing_cols_ref] <- NA
}
if(length(missing_cols_mat) > 0) {
ref_mat[, missing_cols_mat] <- NA
}
ref_mat <- abind::abind(ref_mat, mat, along = 3)
}
ref_mat
}
