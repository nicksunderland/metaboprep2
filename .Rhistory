sheets <- readxl::excel_sheets(filepath)
sheets <- sheets[sheets %in% c("OrigScale", "ScaledImp")]
data_list <- list()
features_list <- list()
batch_list <- list()
for (sheet in sheets) {
raw <- suppressMessages(
readxl::read_xlsx(filepath, sheet=sheet, col_names=FALSE) |> data.table::as.data.table()
)
data_header_row    <- which(raw[, 1] == "metabolite_id")
batch_header_col   <- which(raw[1, ] == "SAMPLE NAME")
data_start_row     <- data_header_row + 1L
data_start_col     <- batch_header_col + 1L
batch_header_row   <- 1L
batch_start_row    <- batch_header_row + 1L
batch_end_row      <- data_header_row - 1L
feature_start_row  <- data_header_row + 1L
feature_start_col  <- 1L
feature_end_col    <- batch_header_col - 1L
data <- as.matrix(raw[data_start_row:nrow(raw), data_start_col:ncol(raw)])
rownames(data) <- raw[data_start_row:nrow(raw)][[1]]
colnames(data) <- raw[data_header_row, data_start_col:ncol(raw)]
batch <- as.matrix(raw[batch_start_row:batch_end_row, batch_header_col:ncol(raw)])
rownames(batch) <- raw[batch_start_row:batch_end_row][[batch_header_col]]
colnames(batch) <- raw[batch_header_row, batch_header_col:ncol(raw)]
features <- as.matrix(raw[feature_start_row:nrow(raw), feature_start_col+1:feature_end_col])
rownames(features) <- raw[feature_start_row:nrow(raw)][[1]]
colnames(features) <- raw[data_header_row, feature_start_col:feature_end_col]
data_list[[sheet]] <- data
batch_list[[sheet]] <- batch
features_list[[sheet]] <- features
}
