stack_matrices <- function(mat_list, type) {
ref_mat <- mat_list[[1]]
for (mat in mat_list) {
if (!identical(rownames(ref_mat), rownames(mat))) {
stop(paste("Row names of", type, "matrix do not match across sheets!"))
}
if (!identical(colnames(ref_mat), colnames(mat))) {
stop(paste("Column names of", type, "matrix do not match across sheets!"))
}
}
array(
unlist(mat_list, use.names = FALSE),
dim = c(nrow(ref_mat), ncol(ref_mat), length(mat_list)),
dimnames = list(
rownames(ref_mat),
colnames(ref_mat),
sheets
)
)
}
